; Manifiesto GDExtension que conecta Godot 4.7.2 con la librería compilada en Rust.
;
; Lógica: Indica el símbolo de arranque (`gdext_rust_init`), la versión mínima
; compatible de Godot (4.7) y las rutas exactas de los binarios `.so` para
; Android de 64 bits (arm64-v8a) y 32 bits (armeabi-v7a).

[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

android.debug.arm64 = "res://bin/aarch64/libcolonia_core.so"
android.release.arm64 = "res://bin/aarch64/libcolonia_core.so"
android.debug.armeabi-v7a = "res://bin/armv7/libcolonia_core.so"
android.release.armeabi-v7a = "res://bin/armv7/libcolonia_core.so"

linux.debug.x86_64 = "res://bin/linux/libcolonia_core.so"
linux.release.x86_64 = "res://bin/linux/libcolonia_core.so"
